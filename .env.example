SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=

# Comma-separated list of origins allowed to call the API.
# Defaults to the local Vite dev server ports if unset.
CORS_ORIGIN=http://localhost:5174,http://localhost:5173

# Optional. Sentry DSN for error monitoring. Leave unset to disable (fine for
# local dev; required before a real deployment so failures are visible).
SENTRY_DSN=

# Optional. Resend API key for outbound email (shortlist notifications).
# Leave unset to disable sending — the shortlist endpoint returns a 503
# instead of silently failing.
RESEND_API_KEY=

# Optional. Sender address for outbound email. Defaults to Resend's shared
# onboarding domain, which only delivers to the Resend account owner until a
# custom domain is verified — set this once a domain is verified.
MAIL_FROM=

# Optional. Adzuna job-search API credentials, used by the job ingestion CLI
# (npm run ingest) to populate the seeker-side job corpus. Get a free key at
# https://developer.adzuna.com (free tier ~1000 calls/month). Leave unset to
# skip job ingestion.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna country code for searches (e.g. us, gb, in, ca, au). Defaults to us.
ADZUNA_COUNTRY=
