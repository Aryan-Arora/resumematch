SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=

# Optional. If set, all /api routes (except /api/health) require this value
# in the `x-api-key` request header. Leave unset for local dev.
APP_PASSWORD=

# Comma-separated list of origins allowed to call the API.
# Defaults to the local Vite dev server ports if unset.
CORS_ORIGIN=http://localhost:5174,http://localhost:5173
